#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main()
{
    int n, e;

    cout << "Enter number of emergency stations: ";
    cin >> n;

    if (n <= 0)
    {
        cout << "Invalid number of stations!\n";
        return 0;
    }

    cout << "Enter number of road connections: ";
    cin >> e;

    if (e < 0)
    {
        cout << "Invalid number of connections!\n";
        return 0;
    }

    vector<vector<int>> adj(n);

    cout << "Enter road connections (u v):\n";

    for (int i = 0; i < e; i++)
    {
        int u, v;
        cin >> u >> v;

        if (u < 0 || u >= n || v < 0 || v >= n)
        {
            cout << "Invalid road connection!\n";
            return 0;
        }

        // Undirected graph
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    int source;

    cout << "Enter starting vertex (0 to "
         << n - 1 << "): ";
    cin >> source;

    if (source < 0 || source >= n)
    {
        cout << "Invalid starting vertex!\n";
        return 0;
    }

    vector<bool> visited(n, false);
    vector<int> level(n, -1);
    vector<int> traversal;
    queue<int> q;

    // Initialize BFS
    visited[source] = true;
    level[source] = 0;
    q.push(source);

    // Breadth First Search
    while (!q.empty())
    {
        int current = q.front();
        q.pop();

        traversal.push_back(current);

        for (int neighbour : adj[current])
        {
            if (!visited[neighbour])
            {
                visited[neighbour] = true;
                level[neighbour] = level[current] + 1;
                q.push(neighbour);
            }
        }
    }

    // Modification A
    cout << "\nBFS Traversal Order: ";
    for (int v : traversal)
        cout << v << " ";

    // Modification B
    cout << "\nReachable Stations: ";
    for (int v : traversal)
        cout << v << " ";

    cout << "\nUnreachable Stations: ";
    bool found = false;

    for (int i = 0; i < n; i++)
    {
        if (!visited[i])
        {
            cout << i << " ";
            found = true;
        }
    }

    if (!found)
        cout << "None";

    // Modification C
    cout << "\nNumber of Reachable Stations: "
         << traversal.size() << endl;

    cout << "\nBFS Levels:\n";
    for (int i = 0; i < n; i++)
    {
        if (visited[i])
            cout << "Station " << i
                 << " : Level " << level[i] << endl;
    }

    return 0;
}
