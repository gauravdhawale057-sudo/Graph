#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main()
{
    int n, e;

    cout << "Enter number of emergency stations: ";
    cin >> n;

    cout << "Enter number of road connections: ";
    cin >> e;

    vector<vector<int>> adj(n);
    vector<bool> visited(n, false);

    cout << "Enter road connections (station1 station2):\n";

    for (int i = 0; i < e; i++)
    {
        int u, v;
        cin >> u >> v;

        // Undirected road connection
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    int source;
    cout << "Enter source station (0 to "
         << n - 1 << "): ";
    cin >> source;

    if (source < 0 || source >= n)
    {
        cout << "Invalid source station!\n";
        return 0;
    }

    queue<int> q;
    vector<int> traversal;

    visited[source] = true;
    q.push(source);

    // BFS traversal
    while (!q.empty())
    {
        int current = q.front();
        q.pop();

        traversal.push_back(current);

        for (int neighbour : adj[current])
        {
            if (!visited[neighbour])
            {
                visited[neighbour] = true;
                q.push(neighbour);
            }
        }
    }

    cout << "\nBFS Traversal Order: ";
    for (int station : traversal)
    {
        cout << station << " ";
    }

    cout << "\nReachable Stations: ";
    for (int station : traversal)
    {
        cout << station << " ";
    }

    cout << "\nUnreachable Stations: ";
    bool found = false;

    for (int i = 0; i < n; i++)
    {
        if (!visited[i])
        {
            cout << i << " ";
            found = true;
        }
    }

    if (!found)
        cout << "None";

    cout << endl;

    return 0;
}
